generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id            Int      @id @default(autoincrement())
  studentNumber String
  firstName     String
  lastName      String
  middleName    String?
  age           Int
  address       String
  gradeLevel    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
